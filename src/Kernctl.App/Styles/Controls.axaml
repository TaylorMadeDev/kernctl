<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="LineHeight" Value="38" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="15,7" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Hover}" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Opacity" Value="0.82" />
  </Style>
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.42" />
  </Style>
  <Style Selector="Button.outline">
    <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.outline:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="38,8,12,8" />
    <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
    <Setter Property="Watermark" Value="Search tools" />
  </Style>
  <Style Selector="TextBox.search:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>
  <Style Selector="TextBox.search:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="ListBox.navigation">
    <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.navigation > ListBoxItem">
    <Setter Property="Height" Value="52" />
    <Setter Property="Margin" Value="8,2" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="ListBox.navigation > ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Primary}" />
  </Style>
  <Style Selector="ListBox.navigation > ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Secondary}" />
  </Style>
  <Style Selector="ListBox.navigation > ListBoxItem:selected Border.selection-indicator">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ListBox.navigation > ListBoxItem:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.tool-card">
    <Setter Property="MinHeight" Value="106" />
    <Setter Property="Padding" Value="20,17" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
  </Style>
  <Style Selector="Border.tool-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Secondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>

  <Style Selector="ToggleSwitch.kernctl">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
            Name="PART_Track"
            Width="44"
            Height="24"
            Padding="3"
            Background="{DynamicResource Brush.Surface.Pressed}"
            BorderBrush="{DynamicResource Brush.Text.Muted}"
            BorderThickness="1"
            CornerRadius="12">
          <Canvas Width="38" Height="18">
            <Grid
                Name="PART_MovingKnobs"
                Width="16"
                Height="16"
                Canvas.Left="0"
                Canvas.Top="1">
              <Ellipse
                  Name="PART_Thumb"
                  Width="16"
                  Height="16"
                  Fill="{DynamicResource Brush.Text.Secondary}" />
            </Grid>
          </Canvas>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch.kernctl:pointerover /template/ Border#PART_Track">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="ToggleSwitch.kernctl:checked /template/ Border#PART_Track">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="ToggleSwitch.kernctl:checked:pointerover /template/ Border#PART_Track">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Hover}" />
  </Style>
  <Style Selector="ToggleSwitch.kernctl:checked /template/ Ellipse#PART_Thumb">
    <Setter Property="Fill" Value="{DynamicResource Brush.Text.Primary}" />
  </Style>
  <Style Selector="ToggleSwitch.kernctl:focus-visible /template/ Border#PART_Track">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ToggleSwitch.kernctl:disabled">
    <Setter Property="Opacity" Value="0.42" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Secondary}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <Style Selector="Border.dialog">
    <Setter Property="Width" Value="500" />
    <Setter Property="Padding" Value="28" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}" />
  </Style>
  <Style Selector="Border.toast">
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Secondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
  </Style>
</Styles>
