<Application
    x:Class="Kernctl.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Kernctl.App.ViewModels.Pages"
    xmlns:views="using:Kernctl.App.Views"
    RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/DesignTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <SimpleTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Simple/Simple.xaml" />
    <StyleInclude Source="/Styles/Controls.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="pages:GamingPageViewModel">
      <views:GamingPage />
    </DataTemplate>
    <DataTemplate DataType="pages:PlaceholderPageViewModel">
      <views:PlaceholderPage />
    </DataTemplate>
    <DataTemplate DataType="pages:SettingsPageViewModel">
      <views:SettingsPage />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
