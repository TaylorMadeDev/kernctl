<UserControl
    x:Class="Kernctl.App.Views.GamingPage"
    x:DataType="pages:GamingPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kernctl.App.Controls"
    xmlns:pages="using:Kernctl.App.ViewModels.Pages"
    xmlns:services="using:Kernctl.App.Services"
    xmlns:viewModels="using:Kernctl.App.ViewModels">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="36,28,36,36" Spacing="{DynamicResource Page.Spacing}">
      <StackPanel Spacing="3">
        <TextBlock Classes="display" Text="Gaming" />
        <TextBlock Classes="body" Text="Configure your system for gaming" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Tools}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:AdaptiveCardPanel
                HorizontalSpacing="{DynamicResource Grid.Gap}"
                MaximumColumns="3"
                MinimumItemWidth="286"
                VerticalSpacing="{DynamicResource Grid.Gap}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="viewModels:ToolCardViewModel">
            <controls:ToolCard />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock
              VerticalAlignment="Center"
              Classes="caption"
              FontSize="{DynamicResource Font.Size.Caption}"
              Text="ACTIVE PROFILE" />
          <Border
              Grid.Column="1"
              Padding="9,5"
              Background="{DynamicResource Brush.Accent.Subtle}"
              CornerRadius="{DynamicResource Radius.Pill}">
            <TextBlock
                Classes="caption"
                Foreground="{DynamicResource Brush.Accent}"
                Text="{Binding MetricsStatus}" />
          </Border>
        </Grid>

        <Border
            Padding="{DynamicResource Card.Padding}"
            Background="{DynamicResource Brush.Surface.Primary}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Medium}">
          <WrapPanel>
            <Grid
                Width="224"
                Margin="0,5,16,5"
                ColumnDefinitions="36,*"
                VerticalAlignment="Center">
              <Ellipse Width="22" Height="22" Fill="{DynamicResource Brush.Accent}" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock FontSize="{DynamicResource Font.Size.Profile}" FontWeight="SemiBold" Text="{Binding ActiveProfileName}" />
                <TextBlock Classes="body" FontSize="{DynamicResource Font.Size.ToolBody}" Text="{Binding ActiveProfileDescription}" />
              </StackPanel>
            </Grid>

            <Border
                Width="118"
                Margin="0,5,12,5"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1,0,0,0">
              <controls:MetricDisplay
                  Margin="16,0,0,0"
                  Icon="{x:Static services:IconCatalog.Processor}"
                  Label="CPU"
                  Value="{Binding CpuValue}" />
            </Border>
            <Border
                Width="118"
                Margin="0,5,12,5"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1,0,0,0">
              <controls:MetricDisplay
                  Margin="16,0,0,0"
                  Icon="{x:Static services:IconCatalog.Memory}"
                  Label="RAM"
                  Value="{Binding MemoryValue}" />
            </Border>
            <Border
                Width="138"
                Margin="0,5,12,5"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1,0,0,0">
              <controls:MetricDisplay
                  Margin="16,0,0,0"
                  Icon="{x:Static services:IconCatalog.Power}"
                  Label="Power"
                  Value="{Binding PowerValue}" />
            </Border>
            <Button
                Margin="0,5"
                VerticalAlignment="Center"
                Classes="outline"
                Command="{Binding OpenProfileDialogCommand}"
                Content="Change Profile" />
          </WrapPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
