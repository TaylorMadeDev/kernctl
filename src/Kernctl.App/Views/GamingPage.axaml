<UserControl
    x:Class="Kernctl.App.Views.GamingPage"
    x:DataType="pages:GamingPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kernctl.App.Controls"
    xmlns:pages="using:Kernctl.App.ViewModels.Pages"
    xmlns:services="using:Kernctl.App.Services"
    xmlns:viewModels="using:Kernctl.App.ViewModels">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="54,44,54,48" Spacing="28">
      <StackPanel Spacing="5">
        <TextBlock Classes="display" Text="Gaming" />
        <TextBlock Classes="body" Text="Configure your system for gaming" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Tools}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="ContentPresenter">
            <Setter Property="Margin" Value="7" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="viewModels:ToolCardViewModel">
            <controls:ToolCard />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock
              VerticalAlignment="Center"
              Classes="caption"
              FontSize="13"
              Text="ACTIVE PROFILE" />
          <Border
              Grid.Column="1"
              Padding="9,5"
              Background="{DynamicResource Brush.Accent.Subtle}"
              CornerRadius="10">
            <TextBlock
                Classes="caption"
                Foreground="{DynamicResource Brush.Accent}"
                Text="{Binding MetricsStatus}" />
          </Border>
        </Grid>

        <Border
            Padding="28"
            Background="{DynamicResource Brush.Surface.Primary}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Medium}">
          <Grid ColumnDefinitions="2.2*,1.1*,1.1*,1.25*,Auto">
            <Grid ColumnDefinitions="42,*" VerticalAlignment="Center">
              <Ellipse Width="26" Height="26" Fill="{DynamicResource Brush.Accent}" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding ActiveProfileName}" />
                <TextBlock Classes="body" FontSize="14" Text="{Binding ActiveProfileDescription}" />
              </StackPanel>
            </Grid>

            <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1,0,0,0">
              <controls:MetricDisplay
                  Margin="22,0"
                  Icon="{x:Static services:IconCatalog.Processor}"
                  Label="CPU"
                  Value="{Binding CpuValue}" />
            </Border>
            <Border Grid.Column="2" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1,0,0,0">
              <controls:MetricDisplay
                  Margin="22,0"
                  Icon="{x:Static services:IconCatalog.Memory}"
                  Label="RAM"
                  Value="{Binding MemoryValue}" />
            </Border>
            <Border Grid.Column="3" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1,0,0,0">
              <controls:MetricDisplay
                  Margin="22,0"
                  Icon="{x:Static services:IconCatalog.Power}"
                  Label="Power"
                  Value="{Binding PowerValue}" />
            </Border>
            <Button
                Grid.Column="4"
                Margin="24,0,0,0"
                Classes="outline"
                Command="{Binding OpenProfileDialogCommand}"
                Content="Change Profile" />
          </Grid>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
