<Window
    x:Class="Kernctl.App.Views.MainWindow"
    x:DataType="viewModels:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kernctl.App.Controls"
    xmlns:services="using:Kernctl.App.Services"
    xmlns:views="using:Kernctl.App.Views"
    xmlns:viewModels="using:Kernctl.App.ViewModels"
    Width="{DynamicResource Window.Width}"
    Height="{DynamicResource Window.Height}"
    MinWidth="{DynamicResource Window.MinWidth}"
    MinHeight="{DynamicResource Window.MinHeight}"
    Title="kernctl"
    CanResize="True"
    KeyDown="Window_KeyDown"
    ShowInTaskbar="True"
    WindowDecorations="Full"
    WindowStartupLocation="CenterScreen">
  <Grid
      Background="{DynamicResource Brush.Window}"
      ColumnDefinitions="226,*">
    <Border
        Grid.Column="0"
        Background="{DynamicResource Brush.Sidebar}"
        BorderBrush="{DynamicResource Brush.Border.Subtle}"
        BorderThickness="0,0,1,0">
      <Grid RowDefinitions="60,*">
        <StackPanel
            Grid.Row="0"
            Margin="18,0,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="11">
          <controls:LogoMark Width="28" Height="28" />
          <TextBlock
              VerticalAlignment="Center"
              FontSize="{DynamicResource Font.Size.Brand}"
              FontWeight="Bold"
              Text="kernctl" />
        </StackPanel>

        <ListBox
            Grid.Row="1"
            Classes="navigation"
            ItemsSource="{Binding NavigationItems}"
            SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="viewModels:NavigationItemViewModel">
              <Grid ColumnDefinitions="4,46,*">
                <Border
                    Classes="selection-indicator"
                    Width="3"
                    Height="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Accent}"
                    CornerRadius="0,2,2,0"
                    Opacity="0" />
                <controls:SvgIcon
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IconBrush="{DynamicResource Brush.Text.Primary}"
                    Source="{Binding Icon}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource Font.Size.Navigation}"
                    FontWeight="Medium"
                    Text="{Binding Title}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="60,*">
      <Border
          Grid.Row="0"
          Background="{DynamicResource Brush.Window}"
          BorderBrush="{DynamicResource Brush.Border.Subtle}"
          BorderThickness="0,0,0,1">
        <Grid Margin="24,0" ColumnDefinitions="*,300">
          <TextBlock
              VerticalAlignment="Center"
              Classes="caption"
              Text="YOUR PC, UNDER CONTROL." />
          <Grid Grid.Column="1" VerticalAlignment="Center">
            <TextBox
                x:Name="SearchBox"
                Classes="search"
                GotFocus="SearchBox_GotFocus"
                KeyDown="SearchBox_KeyDown"
                Text="{Binding SearchQuery, Mode=TwoWay}" />
            <controls:SvgIcon
                Width="16"
                Height="16"
                Margin="13,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                IconBrush="{DynamicResource Brush.Text.Secondary}"
                Source="{x:Static services:IconCatalog.Search}" />
          </Grid>
        </Grid>
      </Border>

      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>

    <Border
        Grid.Column="1"
        Width="300"
        MaxHeight="380"
        Margin="0,52,24,0"
        Padding="6"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Background="{DynamicResource Brush.Surface.Primary}"
        BorderBrush="{DynamicResource Brush.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="{DynamicResource Radius.Medium}"
        IsVisible="{Binding IsSearchOpen}"
        ZIndex="20">
      <ListBox
          Background="Transparent"
          BorderThickness="0"
          ItemsSource="{Binding SearchResults}"
          SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="viewModels:SearchResultViewModel">
            <Grid Margin="9,7" ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{Binding Title}" />
                <TextBlock Classes="caption" Text="{Binding Category}" />
              </StackPanel>
              <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="caption"
                  Text="{Binding DestinationTitle}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Border
        Grid.ColumnSpan="2"
        Background="{DynamicResource Brush.Overlay}"
        IsVisible="{Binding Gaming.IsProfileDialogOpen}"
        ZIndex="30">
      <Border
          Classes="dialog"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
        <StackPanel Spacing="20">
          <StackPanel Spacing="5">
            <TextBlock Classes="heading" FontSize="{DynamicResource Font.Size.DialogHeading}" Text="Change profile" />
            <TextBlock
                Classes="body"
                Text="Choose a session-only profile. This does not change Windows." />
          </StackPanel>

          <ListBox
              Background="Transparent"
              BorderThickness="0"
              ItemsSource="{Binding Gaming.ProfileChoices}"
              SelectedItem="{Binding Gaming.SelectedProfileChoice, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="viewModels:ProfileChoiceViewModel">
                <Grid Margin="8" ColumnDefinitions="36,*">
                  <controls:SvgIcon
                      Width="20"
                      Height="20"
                      VerticalAlignment="Center"
                      IconBrush="{DynamicResource Brush.Accent}"
                      Source="{Binding Icon}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Classes="label" Text="{Binding Name}" />
                    <TextBlock Classes="caption" Text="{Binding Description}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock
                VerticalAlignment="Center"
                Classes="caption"
                Text="UI state only" />
            <Button
                Grid.Column="1"
                Margin="0,0,10,0"
                Classes="outline"
                Command="{Binding Gaming.CloseProfileDialogCommand}"
                Content="Cancel" />
            <Button
                Grid.Column="2"
                Command="{Binding Gaming.ConfirmProfileCommand}"
                Content="Use profile" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <Border
        Grid.ColumnSpan="2"
        Background="{DynamicResource Brush.Overlay}"
        IsVisible="{Binding Profiles.IsOpen}"
        ZIndex="34">
      <views:ProfileWorkspace
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          DataContext="{Binding Profiles}" />
    </Border>

    <Border
        Grid.ColumnSpan="2"
        Background="{DynamicResource Brush.Overlay}"
        IsVisible="{Binding IsUnsavedNavigationDialogOpen}"
        ZIndex="35">
      <Border Classes="dialog" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <StackPanel Spacing="5">
            <TextBlock Classes="heading" Text="Discard appearance changes?" />
            <TextBlock
                Classes="body"
                Text="Your live preview has not been saved. Discarding restores the previously committed theme." />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Button
                Grid.Column="1"
                Classes="outline"
                Command="{Binding KeepEditingThemeCommand}"
                Content="Keep editing" />
            <Button
                Grid.Column="2"
                Classes="danger"
                Command="{Binding DiscardThemeChangesCommand}"
                Content="Discard changes" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <Border
        Grid.Column="1"
        Margin="0,0,20,20"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Classes="toast"
        IsVisible="False"
        ZIndex="40">
      <TextBlock Text="Notification foundation" />
    </Border>

    <Border
        Grid.Column="1"
        Width="420"
        Margin="0,0,20,20"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        IsVisible="{Binding ActionProgress.IsActive}"
        ZIndex="44">
      <controls:ActionProgressPanel DataContext="{Binding ActionProgress}" />
    </Border>

    <Border
        Grid.ColumnSpan="2"
        Background="{DynamicResource Brush.Overlay}"
        IsVisible="{Binding ActionRecovery.IsOpen}"
        ZIndex="45">
      <controls:ActionRecoveryDialog
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          DataContext="{Binding ActionRecovery}" />
    </Border>
  </Grid>
</Window>
